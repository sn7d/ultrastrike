{
	"schemaVersion": 1,
	"id": "angelichalo",
	"version": "${version}",
	"name": "Angelic Halo",
	"description": "A purely client-side, cosmetic ring of light around your player: scan sweeps with fading trails, crowns, galaxies, orbiting text, projected emblems and a full colour studio, tuned in an animated menu with a live 3D preview. Sends nothing to the server.",
	"authors": [
		"sn7d"
	],
	"contact": {
		"homepage": "https://github.com/sn7d/angelic-halo",
		"sources": "https://github.com/sn7d/angelic-halo",
		"issues": "https://github.com/sn7d/angelic-halo/issues"
	},
	"license": "MIT",
	"icon": "assets/angelichalo/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.angelichalo.AngelicHalo"
		],
		"modmenu": [
			"com.angelichalo.compat.ModMenuCompat"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.github_releases": "https://github.com/sn7d/angelic-halo/releases"
			}
		}
	}
}
